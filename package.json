{
  "name": "arca",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --filter @arca/backend dev",
    "build": "pnpm --filter @arca/backend build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:ps": "docker compose ps",
    "db:migrate": "pnpm --filter @arca/backend db:migrate",
    "db:generate": "pnpm --filter @arca/backend db:generate",
    "db:studio": "pnpm --filter @arca/backend db:studio",
    "db:reset": "pnpm --filter @arca/backend db:reset"
  }
}
